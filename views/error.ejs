<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Server Error' %> | Khushal Paunkar</title>
    <meta name="description" content="An unexpected error occurred.">
    <meta name="robots" content="noindex">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <main id="main" class="error-page">
        <p class="error-code"><%= status %></p>
        <h1 class="error-title">Something went wrong</h1>
        <p class="error-text">
            An unexpected error occurred while handling your request.
        </p>

        <% if (detail) { %>
            <p class="error-path"><code><%= detail %></code></p>
        <% } %>

        <div class="error-actions">
            <a href="/" class="btn btn--primary"><i class="fas fa-arrow-left"></i> Back to Home</a>
        </div>

        <% if (stack) { %>
            <details class="error-stack">
                <summary>Stack trace (development only)</summary>
                <pre><%= stack %></pre>
            </details>
        <% } %>
    </main>
</body>
</html>
