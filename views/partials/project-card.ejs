<%
  /* One project in the "More projects" grid.

     Locals: project, techIcon, placeholderIcon.
     Same rules as the featured card: no image means a placeholder, and no URL
     means no button. */
  const hasImage = Boolean(project.image);
  const links = [
    project.githubUrl ? { href: project.githubUrl, label: 'GitHub' } : null,
    project.liveUrl ? { href: project.liveUrl, label: 'Live Demo' } : null,
  ].filter(Boolean);
%>
<article class="pcard" id="project-<%= project.slug %>" data-reveal>
  <div class="pcard__media">
    <% if (hasImage) { %>
      <img src="<%= project.image %>" alt="<%= project.imageAlt %>" loading="lazy" decoding="async">
    <% } else { %>
      <div class="pf__placeholder">
        <i class="<%= placeholderIcon(project.placeholderIcon) %>" aria-hidden="true"></i>
        <span>No screenshot yet</span>
      </div>
    <% } %>
  </div>

  <div class="pcard__body">
    <div class="pf__tags">
      <% if (project.category) { %><span class="badge badge--muted"><%= project.category %></span><% } %>
      <% (project.tags || []).forEach(function (tag) { %>
        <span class="badge badge--muted"><%= tag %></span>
      <% }); %>
      <% if (project.year) { %><span class="badge badge--muted"><%= project.year %></span><% } %>
    </div>

    <h3 class="pcard__title"><a class="pcard__title-link" href="/projects/<%= project.slug %>"><%= project.title %></a></h3>
    <% if (project.shortDescription) { %>
      <p class="pcard__text"><%= project.shortDescription %></p>
    <% } %>

    <div class="pcard__foot">
      <% if ((project.technologies || []).length) { %>
        <div class="pf__stack pcard__stack">
          <% project.technologies.forEach(function (tech) { %>
            <span class="chip"><i class="<%= techIcon(tech) %>" aria-hidden="true"></i> <%= tech %></span>
          <% }); %>
        </div>
      <% } %>

      <% if (links.length) { %>
        <div class="pcard__links">
          <% links.forEach(function (link) { %>
            <a class="pcard__link" href="<%= link.href %>" target="_blank" rel="noopener">
              <%= link.label %> <i class="fas fa-arrow-right" aria-hidden="true"></i>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <span class="pf__note"><i class="fas fa-lock" aria-hidden="true"></i> Link soon</span>
      <% } %>
    </div>
  </div>
</article>
