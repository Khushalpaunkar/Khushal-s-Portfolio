  <!-- ============================================================
       PROJECTS
       Projects come from services/projectService.js, which reads MongoDB when
       it is reachable and the bundled seed data when it is not. Nothing here
       is hardcoded and no URL is invented: a missing link renders no button,
       a missing image renders the labelled placeholder.

       Three tiers, chosen from the data rather than hardcoded:
         featured[0]  -> the hero, media-dominant
         featured[1..] -> spotlight rows, alternating left/right
         others       -> an image-first grid
       Each tier passes a running index so the section reads as one ordered
       sequence no matter how many projects the database returns.
       ============================================================ -->
    <section class="section projects" id="projects">
    <div class="container">
      <div class="section-head">
        <p class="section-head__label mono">Projects</p>
        <h2 class="section-head__title">My Work, Built to Solve Real Problems</h2>
        <p class="section-head__sub">
          A selection of projects built through hands-on development, problem solving, and continuous learning —
          from full-stack web applications to AI-powered solutions and practical developer tools.
        </p>
      </div>

      <% var featuredCount = projects.featured.length;
         var total = featuredCount + projects.others.length; %>

      <% if (total) { %>
        <p class="work__count mono">
          <%= String(total).padStart(2, '0') %> projects
          <% if (featuredCount) { %>
            <span class="work__count-split">&mdash; <%= featuredCount %> featured</span>
          <% } %>
        </p>
      <% } %>

      <% if (projects.featured.length) { %>
        <div class="work__stack">
          <% projects.featured.forEach(function (project, index) { %>
            <%- include('partials/project-featured', {
                  project: project,
                  n: index + 1,
                  variant: index === 0 ? 'hero' : 'spot',
                  flip: index % 2 === 0,
                  techIcon: techIcon,
                  placeholderIcon: placeholderIcon,
                }) %>
          <% }); %>
        </div>
      <% } %>

      <% if (projects.others.length) { %>
        <div class="work__divider">
          <span class="mono">More projects</span>
        </div>

        <div class="work__grid">
          <% projects.others.forEach(function (project, index) { %>
            <%- include('partials/project-card', {
                  project: project,
                  n: featuredCount + index + 1,
                  techIcon: techIcon,
                  placeholderIcon: placeholderIcon,
                }) %>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>


