    <section class="section" id="contact">
    <div class="container">
      <div class="contact__grid">

        <div data-reveal>
          <p class="section-head__label mono">Contact</p>
          <h2 class="contact__title">Let's build<br><em>something together.</em></h2>
          <p class="contact__text">
          Have a project in mind, want to discuss an opportunity, or simply want to connect? I'd genuinely love to hear from you.
          </p>

          <div class="contact__links">
            <% if (sEmail) { %>
            <a class="link-row" href="mailto:<%= sEmail %>">
              <span class="link-row__icon"><i class="fa-solid fa-envelope"></i></span>
              <span>
                <span class="link-row__label">Email</span>
                <span class="link-row__value"><%= sEmail %></span>
              </span>
              <i class="fas fa-arrow-right link-row__arrow" aria-hidden="true"></i>
            </a>
            <% } %>

            <% if (sGithub) { %>
            <a class="link-row" href="<%= sGithub %>" target="_blank" rel="noopener">
              <span class="link-row__icon"><i class="fa-brands fa-github"></i></span>
              <span>
                <span class="link-row__label">GitHub</span>
                <span class="link-row__value"><%= sGithubDisplay %></span>
              </span>
              <i class="fas fa-arrow-right link-row__arrow" aria-hidden="true"></i>
            </a>
            <% } %>

          <% if (sLinkedin) { %>
          <a class="link-row" href="<%= sLinkedin %>" target="_blank" rel="noopener">
            <span class="link-row__icon"><i class="fa-brands fa-linkedin-in"></i></span>
            <span>
              <span class="link-row__label">LinkedIn</span>
              <span class="link-row__value"><%= sLinkedin.replace(/^https?:\/\//, '') %></span>
            </span>
            <i class="fas fa-arrow-right link-row__arrow" aria-hidden="true"></i>
          </a>
          <% } %>

          <% if (sInstagram) { %>
          <a class="link-row" href="<%= sInstagram %>" target="_blank" rel="noopener">
            <span class="link-row__icon"><i class="fa-brands fa-instagram"></i></span>
            <span>
              <span class="link-row__label">Instagram</span>
              <span class="link-row__value"><%= sInstagram.replace(/^https?:\/\//, '') %></span>
            </span>
            <i class="fas fa-arrow-right link-row__arrow" aria-hidden="true"></i>
          </a>
          <% } %>

          <% if (sResume) { %>
          <a class="link-row" href="<%= sResume %>" target="_blank" rel="noopener">
            <span class="link-row__icon"><i class="fa-solid fa-file-arrow-down"></i></span>
            <span>
              <span class="link-row__label">Resume</span>
              <span class="link-row__value">Download PDF</span>
            </span>
            <i class="fas fa-arrow-right link-row__arrow" aria-hidden="true"></i>
          </a>
          <% } %>
          </div>
        </div>

        <!-- Submissions POST to /api/contact (Express + MongoDB, Phase 7).
             The honeypot field is invisible to people and catches bots. -->
        <form class="form" id="contact-form" novalidate data-reveal>
          <div class="field hp-field" aria-hidden="true">
            <label for="cf-website">Website</label>
            <input class="input" type="text" id="cf-website" name="website" tabindex="-1" autocomplete="off">
          </div>

          <div class="field">
            <label class="field__label" for="cf-name">Name <span aria-hidden="true">*</span></label>
            <input class="input" type="text" id="cf-name" name="name"
                   placeholder="Your name" autocomplete="name" required
                   maxlength="80" aria-describedby="cf-name-err">
            <p class="field__error" id="cf-name-err" role="alert"></p>
          </div>

          <div class="field">
            <label class="field__label" for="cf-email">Email <span aria-hidden="true">*</span></label>
            <input class="input" type="email" id="cf-email" name="email"
                   placeholder="you@example.com" autocomplete="email" required
                   maxlength="160" aria-describedby="cf-email-err">
            <p class="field__error" id="cf-email-err" role="alert"></p>
          </div>

          <div class="field">
            <label class="field__label" for="cf-subject">Subject</label>
            <input class="input" type="text" id="cf-subject" name="subject"
                   placeholder="What is this about?" maxlength="140">
          </div>

          <div class="field">
            <label class="field__label" for="cf-message">Message <span aria-hidden="true">*</span></label>
            <textarea class="input" id="cf-message" name="message" rows="5"
                      placeholder="Tell me about your project or idea" required
                      minlength="10" maxlength="2000" aria-describedby="cf-message-err"></textarea>
            <p class="field__error" id="cf-message-err" role="alert"></p>
          </div>

          <div class="form__foot">
            <button class="btn btn--primary" type="submit" id="cf-submit">
              <i class="fas fa-paper-plane"></i> Send Message
            </button>
            <p class="form__status" id="cf-status" role="status" aria-live="polite"></p>
          </div>

          <noscript>
            <% if (sEmail) { %>
            <p class="form__noscript">
              JavaScript is off, so this form can't submit. Email me instead:
              <a href="mailto:<%= sEmail %>"><%= sEmail %></a>.
            </p>
            <% } %>
          </noscript>
        </form>

      </div>
    </div>
  </section>

