<!doctype html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <style>
    .admin-toolbar h1 { margin: 0 0 1.2rem; font-size: 1.5rem; }
    .form--narrow { max-width: 560px; }
  </style>
</head>
<body class="admin-body">
  <%- include('partials/topbar') %>

  <main id="main">
  <div class="admin-toolbar">
    <h1>Change password</h1>
  </div>

  <p class="field__hint">
    Changing your password signs out every other session immediately.
    You will stay signed in on this device.
  </p>

  <% if (errors && errors._form) { %>
    <p class="form__status is-on form__status--err" role="alert"><%= errors._form %></p>
  <% } %>

  <form class="form form-grid form--narrow" method="post" action="/admin/password" id="password-form">
    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

    <div class="field field--wide">
      <label class="field__label" for="pw-current">Current password <span aria-hidden="true">*</span></label>
      <input class="input" type="password" id="pw-current" name="currentPassword"
             required autocomplete="current-password">
      <% if (errors && errors.currentPassword) { %><p class="field__error is-on" role="alert"><%= errors.currentPassword %></p><% } %>
    </div>

    <div class="field field--wide">
      <label class="field__label" for="pw-new">New password <span aria-hidden="true">*</span></label>
      <input class="input" type="password" id="pw-new" name="newPassword"
             required minlength="8" autocomplete="new-password">
      <p class="field__hint">At least 8 characters.</p>
      <% if (errors && errors.newPassword) { %><p class="field__error is-on" role="alert"><%= errors.newPassword %></p><% } %>
    </div>

    <div class="field field--wide">
      <label class="field__label" for="pw-confirm">Confirm new password <span aria-hidden="true">*</span></label>
      <input class="input" type="password" id="pw-confirm" name="confirmPassword"
             required autocomplete="new-password">
      <% if (errors && errors.confirmPassword) { %><p class="field__error is-on" role="alert"><%= errors.confirmPassword %></p><% } %>
    </div>

    <div class="field--wide">
      <button class="btn btn--primary" type="submit">Update password</button>
      <a class="btn btn--ghost" href="/admin">Cancel</a>
    </div>
  </form>
  </main>
</body>
</html>