<meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> — Admin</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%2308090b'/><text x='50' y='68' font-family='monospace' font-size='54' font-weight='700' fill='%23ff8a00' text-anchor='middle'>KP</text></svg>">
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .admin-body { min-height: 100vh; max-width: 60rem; margin: 0 auto; padding: 1.5rem;
      background: radial-gradient(60rem 30rem at 90% -10%, rgba(255,138,0,.12), transparent 60%), var(--bg); }
    .admin-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      flex-wrap: wrap; border-bottom: 1px solid var(--border); padding-bottom: 1rem; margin-bottom: 1.6rem; }
    .admin-nav { display: flex; align-items: center; gap: 1.2rem; }
    .admin-nav a { color: var(--muted); text-decoration: none; font-size: .95rem; }
    .admin-nav a:hover { color: var(--accent-ink); }
    .admin-top__right { display: flex; align-items: center; gap: 1.2rem; }
    .admin-top__right a { color: var(--muted); font-size: .92rem; }
    .admin-top__right form { margin: 0; }
    .btn-danger { background: var(--danger, #c0392b); color: #fff; }
    @media (max-width: 640px) { .admin-nav { gap: .8rem; flex-wrap: wrap; } }
  </style>