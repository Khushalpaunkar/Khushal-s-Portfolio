<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= status %> — Admin</title>
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .admin-body { min-height: 100vh; display: grid; place-items: center; padding: 1.5rem;
      background: radial-gradient(60rem 30rem at 85% -10%, rgba(255,138,0,.12), transparent 60%), var(--bg); }
    .admin-card { width: 100%; max-width: 30rem; padding: 2rem 2.2rem;
      border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); }
    .admin-card h1 { font-size: var(--fs-h3); margin: 0 0 .5rem; }
    .admin-card p { color: var(--muted); }
    .admin-card a { color: var(--accent-ink); }
  </style>
</head>
<body class="admin-body">
  <main id="main" class="admin-card">
    <h1><%= status %></h1>
    <p><%= message %></p>
    <p><a href="/admin">Back to dashboard</a></p>
  </main>
</body>
</html>